<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#1B2631"
    android:gravity="center"
    android:orientation="vertical"
    android:textAlignment="center"

    tools:context=".MainActivity">

    <!-- TIÊU ĐỀ PROFILE -->
    <TextView
        android:id="@+id/txtProfile"
        android:layout_width="391dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="start"
        android:text="Profile"
        android:textAlignment="viewStart"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- CARD HỒ SƠ SINH VIÊN -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="384dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#243342"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- AVATAR -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="137dp"
                android:layout_height="155dp"
                android:layout_gravity="center_horizontal"
                android:background="#FFFFFF"
                android:textAlignment="center"
                app:srcCompat="@drawable/avater_student" />

            <!-- TÊN -->
            <TextView
                android:id="@+id/txtTen"
                android:layout_width="306dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- MSSV + LỚP -->
            <TextView
                android:id="@+id/txtMaSinhVien"
                android:layout_width="257dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="normal" />

            <!-- SỐ ĐIỆN THOẠI -->
            <TextView
                android:id="@+id/txtSoDienThoai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <!-- VÒNG TRÒN GPA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGpa"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="75dp">

                <TextView
                    android:id="@+id/txtDiem"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="#090909"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtGPA"
                    android:layout_width="138dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </androidx.cardview.widget.CardView>

            <!-- NHẬP GPA -->
            <EditText
                android:id="@+id/edtGPA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:ems="10"
                android:hint="Nhập GPA mới (0.0 - 4.0)"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:textColor="#FFFFFF" />

            <!-- NÚT CẬP NHẬT -->
            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="323dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="18dp"
                android:text="Cập nhật thông tin" />

            <!-- NÚT GỌI ĐIỆN -->
            <Button
                android:id="@+id/btnCall"
                android:layout_width="323dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:text="Gọi điện" />

            <!-- NÚT XÓA HỒ SƠ -->
            <Button
                android:id="@+id/btnDelete"
                android:layout_width="323dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:text="Xóa hồ sơ" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>